{
  "name": "qa-playwright-agents-archetype",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright archetype with AI testing agents: risk-based exploratory testing, screen-by-screen validation and test generation with human approval.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npx playwright install --with-deps",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:headed": "playwright test --headed --project=chromium",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "report:publish": "node scripts/publish-report.mjs",
    "codegen": "playwright codegen",
    "typecheck": "tsc --noEmit",
    "lint:specs": "node scripts/check-traceability.mjs",
    "test:example": "playwright test tests/e2e/demoblaze tests/bugs/demoblaze --project=chromium",
    "example:remove": "remove-example.bat"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.0"
  }
}
